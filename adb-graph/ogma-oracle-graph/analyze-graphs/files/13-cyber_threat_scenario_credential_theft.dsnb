        "message" : [
          "%md",
          "",
          "**6b.** Rank the candidates. The query reads the PageRank scores from `computer_pagerank`."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
