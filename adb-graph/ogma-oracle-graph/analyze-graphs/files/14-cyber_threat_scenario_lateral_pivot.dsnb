        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "CREATE TABLE IF NOT EXISTS computer_pagerank AS",
          "SELECT",
          "  computer,",
          "  pagerank_score",
          "FROM",
          "  GRAPH_TABLE (",
          "    DBMS_OGA.PAGERANK (",
          "      lanl_cyber_graph,",
          "      PROPERTY (VERTEX OUTPUT rank),",
          "      10, 1.0, 0.85d, FALSE",
          "    )",
          "    MATCH (c IS computer)",
          "    COLUMNS (",
          "      c.computer AS computer,",
          "      c.rank     AS pagerank_score",
          "    )",
          "  );"
        ],
        "selectedVisualization" : "table",
