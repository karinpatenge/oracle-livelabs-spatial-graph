        "message" : [
          "%sql",
          "",
          "-- Replace 'C17693' (three times) with a candidate from Step 3",
          "WITH candidate_reach AS (",
          "  SELECT 'C17693' AS computer FROM DUAL",
          "  UNION",
          "  SELECT computer",
          "  FROM",
          "    GRAPH_TABLE (",
          "      lanl_cyber_graph",
          "      MATCH (src IS computer WHERE src.computer = 'C17693')",
          "              -[e IS auth_connected]->{1,2} (reached IS computer)",
          "      COLUMNS (reached.computer AS computer)",
          "    )",
          "),",
          "computer_importance AS (",
          "  SELECT computer, pagerank_score",
          "  FROM computer_pagerank   -- stored in Step 6a",
          ")",
          "SELECT",
          "  r.computer,",
          "  CASE WHEN r.computer = 'C17693' THEN 'STAGING_HOST' ELSE 'REACHED' END AS role,",
          "  imp.pagerank_score",
          "FROM",
          "  candidate_reach r",
          "  JOIN computer_importance imp ON imp.computer = r.computer",
          "ORDER BY",
          "  imp.pagerank_score DESC",
          "FETCH APPROX FIRST 100 ROWS ONLY;   -- limit to a manageable number"
        ],
