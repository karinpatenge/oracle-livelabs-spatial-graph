        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "### Step 4: Time-Respecting Reach",
          "",
          "How far do the onward hops get per staging host? The query uses the same pattern as Step 2 and counts, per staging host, the victims with onward hops and the computers they reach in the second hop. Compare `computers_reached_second_hop` with the static two-hop reach of Scenario 2, which ignores time."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "SELECT",
          "  staging_host,",
          "  COUNT(DISTINCT victim)                                                      AS victims_with_onward_hops,",
          "  COUNT(DISTINCT next_computer)                                               AS computers_reached_second_hop,",
          "  COUNT(DISTINCT CASE WHEN account_out <> account_in THEN next_computer END)  AS reached_with_other_account,",
          "  COUNT(DISTINCT CASE WHEN account_out <> account_in THEN account_out END)    AS other_accounts_used",
          "FROM",
          "  GRAPH_TABLE (",
          "    lanl_cyber_graph",
          "    MATCH",
          "      (u1 IS user_domain) -[a1 IS auth_src_authenticated]-> (s IS computer)",
          "        -[h1 IS auth_connected]-> (v IS computer)",
          "        -[h2 IS auth_connected]-> (w IS computer),",
          "      (u2 IS user_domain) -[a2 IS auth_src_authenticated]-> (v)",
          "    WHERE",
          "      h1.redteam = 1",
          "      AND a1.id = h1.id",
          "      AND a2.id = h2.id",
          "      AND h2.time > h1.time",
          "      AND h2.time <= h1.time + 3600",
          "      AND w.computer <> s.computer",
          "      AND w.computer <> v.computer",
          "      AND u2.user_domain NOT LIKE 'ANONYMOUS LOGON@%'",
          "      AND u2.user_domain NOT LIKE 'NETWORK SERVICE@%'",
          "      AND u2.user_domain NOT LIKE '%$@%'",
          "    COLUMNS (",
          "      s.computer     AS staging_host,",
          "      v.computer     AS victim,",
          "      u1.user_domain AS account_in,",
          "      u2.user_domain AS account_out,",
          "      w.computer     AS next_computer",
          "    )",
          "  )",
          "GROUP BY",
          "  staging_host",
          "ORDER BY",
          "  computers_reached_second_hop DESC;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
