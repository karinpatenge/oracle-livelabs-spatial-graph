      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**5c.** Show the rank of every labeled relay host and of every relay host with a confirmed incoming hop. `switch_rank` is the rank by account switches among all relay hosts (`relay_hosts_total`)."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "WITH relays AS (",
          "  SELECT",
          "    relay_host,",
          "    COUNT(DISTINCT account_in || ' > ' || account_out)                          AS account_switches,",
          "    COUNT(DISTINCT next_computer)                                               AS next_computers,",
          "    MAX(confirmed_hop_in)                                                       AS has_confirmed_hop_in,",
          "    RANK() OVER (ORDER BY COUNT(DISTINCT account_in || ' > ' || account_out) DESC) AS switch_rank,",
          "    COUNT(*) OVER ()                                                            AS relay_hosts_total",
          "  FROM",
          "    credential_hop_chains   -- stored in Step 5a",
          "  GROUP BY",
          "    relay_host",
          "),",
          "labeled AS (",
          "  SELECT",
          "    r.relay_host,",
          "    CASE",
          "      WHEN st.computer IS NOT NULL THEN 'STAGING_HOST'",
          "      WHEN vi.computer IS NOT NULL THEN 'CONFIRMED_VICTIM'",
          "      ELSE 'UNLABELED'",
          "    END AS role,",
          "    r.switch_rank,",
          "    r.relay_hosts_total,",
          "    r.account_switches,",
          "    r.next_computers,",
          "    r.has_confirmed_hop_in",
          "  FROM",
          "    relays r",
          "    LEFT JOIN (SELECT DISTINCT src_computer AS computer FROM redteam) st ON st.computer = r.relay_host",
          "    LEFT JOIN (SELECT DISTINCT dst_computer AS computer FROM redteam) vi ON vi.computer = r.relay_host",
          ")",
          "SELECT",
          "  relay_host,",
          "  role,",
          "  switch_rank,",
          "  relay_hosts_total,",
          "  account_switches,",
          "  next_computers,",
          "  has_confirmed_hop_in",
          "FROM",
          "  labeled",
          "WHERE",
          "  role <> 'UNLABELED'",
          "  OR has_confirmed_hop_in = 1",
          "ORDER BY",
          "  switch_rank",
          "FETCH APPROX FIRST 100 ROWS ONLY;"
        ],
