        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%md",
          "",
          "**6b.** Rank the computers at the end of the chains by PageRank. `relay_hosts` counts the relay hosts that lead to a computer, `accounts_used` the accounts used for the last hop, and `after_confirmed_hop` shows whether a chain with a confirmed incoming hop ends there."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : null,
        "relations" : [],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql",
          "",
          "WITH chain_ends AS (",
          "  SELECT",
          "    next_computer,",
          "    COUNT(DISTINCT relay_host)  AS relay_hosts,",
          "    COUNT(DISTINCT account_out) AS accounts_used,",
          "    MAX(confirmed_hop_in)       AS after_confirmed_hop",
          "  FROM",
          "    credential_hop_chains   -- stored in Step 5a",
          "  GROUP BY",
          "    next_computer",
          ")",
          "SELECT",
          "  e.next_computer,",
          "  e.relay_hosts,",
          "  e.accounts_used,",
          "  e.after_confirmed_hop,",
          "  p.pagerank_score",
          "FROM",
          "  chain_ends e",
          "  JOIN computer_pagerank p ON p.computer = e.next_computer   -- stored in Step 6a",
          "ORDER BY",
          "  p.pagerank_score DESC",
          "FETCH APPROX FIRST 100 ROWS ONLY;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
